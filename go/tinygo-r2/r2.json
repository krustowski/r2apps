{
	"llvm-target": "x86_64-unknown-none",
	"cpu": "x86-64",
	"build-tags": ["r2", "baremetal", "linux", "amd64"],
	"goos": "linux",
	"goarch": "amd64",
	"scheduler": "tasks",
	"gc": "conservative",
	"linker": "ld.lld",
	"rtlib": "compiler-rt",
	"libc": "picolibc",
	"default-stack-size": 32768,
	"cflags": [
		"-target", "x86_64-unknown-none",
		"-mno-red-zone",
		"-fno-exceptions", "-fno-unwind-tables", "-fno-asynchronous-unwind-tables",
		"-ffunction-sections", "-fdata-sections"
	],
	"ldflags": [
		"--gc-sections",
		"--no-pie",
		"-static"
	],
	"linkerscript": "targets/r2.ld",
	"extra-files": [
		"targets/r2.S",
		"src/runtime/asm_amd64.S",
		"src/internal/task/task_stack_amd64.S"
	]
}
